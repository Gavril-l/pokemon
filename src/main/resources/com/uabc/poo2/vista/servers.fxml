<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="400.0" minWidth="640.0" prefHeight="400.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uabc.poo2.controlador.ServersPageControlador">
   <top>
      <BorderPane BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <left>
            <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#onRegresarClick" text="Regresar" BorderPane.alignment="CENTER" />
         </left>
         <center>
            <Label text="MatchMaking" textFill="#2c3e50" BorderPane.alignment="CENTER">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
            </Label>
         </center>
         <right>
            <HBox prefWidth="75.0" />
         </right>
      </BorderPane>
   </top>
   <center>
      <HBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="0.0" />
         </padding>
         <children>
            <VBox alignment="TOP_CENTER" minWidth="200.0" prefWidth="360.0" spacing="20.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Salas disponibles" textFill="#2c3e50" wrapText="true">
                     <font>
                        <Font name="System Bold" size="26.0" />
                     </font>
                  </Label>
                  <ScrollPane fx:id="spServidoresDisponibles" fitToWidth="true" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <VBox alignment="TOP_CENTER" minWidth="210.0" prefWidth="260.0" spacing="20.0" HBox.hgrow="SOMETIMES">
               <children>
                  <Label text="Inicia una sala" textFill="#2c3e50" wrapText="true">
                     <font>
                        <Font name="System Bold" size="26.0" />
                     </font>
                  </Label>
                  <VBox alignment="CENTER" spacing="20.0">
                     <children>
                        <Button fx:id="btnIniciarServidor" mnemonicParsing="false" onAction="#onIniciarServidorClick" text="Iniciar sala" />
                        <TextField fx:id="txtSala" maxWidth="1.7976931348623157E308" promptText="Nombre de sala" />
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>