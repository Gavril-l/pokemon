<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="raiz" minHeight="560.0" minWidth="760.0" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uabc.poo2.controlador.PartidaController">
    <top>
        <VBox alignment="CENTER" spacing="4.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="6.0" left="20.0" right="20.0" top="12.0" />
            </padding>

            <HBox alignment="CENTER" spacing="30.0">
                <Label fx:id="lblSala" text="Sala: -" textFill="#34495e" />
                <Label fx:id="lblCronometro" text="Tiempo: 20s" textFill="#c0392b" />
            </HBox>

            <Label fx:id="lblEstado" alignment="CENTER" maxWidth="Infinity" text="Estado: Conectado" textAlignment="CENTER" textFill="#27ae60" wrapText="true" />

            <HBox alignment="CENTER" spacing="30.0">
                <Label fx:id="lblMarcadorLocal" />
                <Label fx:id="lblMarcadorOponente" />
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox fx:id="zonaCentro" alignment="CENTER" BorderPane.alignment="CENTER">
            <VBox alignment="CENTER" spacing="4.0">
                <Label fx:id="lblTituloLocal" text="Tu carta" />
                <StackPane fx:id="contenedorCartaLocal" />
            </VBox>
            <VBox alignment="CENTER" spacing="4.0">
                <Label fx:id="lblTituloOponente" text="Oponente" />
                <StackPane fx:id="contenedorCartaOponente" />
            </VBox>
        </HBox>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="14.0" left="10.0" right="10.0" top="4.0" />
            </padding>

            <HBox fx:id="contenedorMano" alignment="CENTER" />
            <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#onVolverClick" text="Volver a salas" />
        </VBox>
    </bottom>
</BorderPane>