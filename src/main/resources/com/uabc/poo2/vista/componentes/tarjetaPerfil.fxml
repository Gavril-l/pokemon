<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="206.0" prefWidth="600.0" spacing="30.0" styleClass=".root" type="HBox" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>
  <children>
    <ImageView fx:id="ivPokemon" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
    <StackPane fx:id="spContenedor" prefHeight="150.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
      <children>
        <VBox fx:id="vistaNormal" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="30.0" visible="false">
          <children>
            <Label fx:id="lblNombre" text="Nombre">
              <font>
                <Font name="System Bold" size="18.0" />
              </font>
            </Label>
            <HBox alignment="CENTER" prefHeight="41.0" prefWidth="309.0" spacing="40.0" VBox.vgrow="ALWAYS">
              <children>
                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                  <children>
                    <Label fx:id="lblVictorias" text="Victorias:" />
                  </children>
                </VBox>
                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                  <children>
                    <Label fx:id="lblDerrotas" text="Derrotas:" />
                  </children>
                </VBox>
              </children>
            </HBox>
          </children>
          <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
          </padding>
        </VBox>
        <VBox fx:id="vistaContraseña" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="30.0" visible="false">
          <children>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
              <children>
                <Label fx:id="lblNombre2" text="Nombre">
                  <font>
                    <Font name="System Bold" size="18.0" />
                  </font>
                </Label>
              </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0" VBox.vgrow="ALWAYS">
              <children>
                <PasswordField fx:id="pfContraseña" onAction="#onEntrarAction" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#onCancelarAction" text="X" />
              </children>
            </HBox>
          </children>
          <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
          </padding>
        </VBox>
        <VBox fx:id="vistaRegistro" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="30.0" StackPane.alignment="CENTER">
          <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
          </padding>
          <children>
            <TextField fx:id="txtIngresarNombre" promptText="Nombre de usuario" VBox.vgrow="ALWAYS" />
            <PasswordField fx:id="pfNuevaContraseña" promptText="Contraseña" />
            <Button fx:id="btnCrearPerfil" mnemonicParsing="false" onAction="#onCrearPerfilAction" text="Crear Perfil" />
          </children>
        </VBox>
      </children>
    </StackPane>
  </children>
</fx:root>
