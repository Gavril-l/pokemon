<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="400.0" minWidth="640.0" prefHeight="400.0" prefWidth="640.0"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uabc.poo2.controlador.EstadisticasController">
   <top>
      <VBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label fx:id="lblTitulo" text="Estadísticas de Combate" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" spacing="40.0">
               <children>
                  <VBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label text="Victorias" textFill="#27ae60">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblVictorias" text="0" textFill="#2c3e50">
                           <font>
                              <Font name="System Bold" size="22.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label text="Derrotas" textFill="#c0392b">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblDerrotas" text="0" textFill="#2c3e50">
                           <font>
                              <Font name="System Bold" size="22.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label text="%% Victoria" textFill="#2980b9">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblPorcentaje" text="0.0%" textFill="#2c3e50">
                           <font>
                              <Font name="System Bold" size="22.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="0.0" />
         </padding>
         <children>
            <Label text="Historial de peleas" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <TableView fx:id="tvHistorial" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colRival" prefWidth="220.0" text="Rival" />
                  <TableColumn fx:id="colResultado" prefWidth="180.0" text="Resultado" />
                  <TableColumn fx:id="colFecha" prefWidth="200.0" text="Fecha" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#onRegresarClick" text="Regresar" />
         </children>
      </HBox>
   </bottom>
</BorderPane>