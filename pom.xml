<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.uabc.poo2</groupId>
  <artifactId>pokemon</artifactId>
  <version>1.0.0</version>

  <properties>
    <app.name>pokemon</app.name>
    <app.module>com.uabc.poo2</app.module>
    <app.mainClass>com.uabc.poo2.vista.App</app.mainClass>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>21</java.version>
    <javafx.version>23.0.1</javafx.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.db4o</groupId>
      <artifactId>db4o-all</artifactId>
      <version>8.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${java.version}</release>
        </configuration>
      </plugin>

      <!-- mvn javafx:run -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${app.module}/${app.mainClass}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- mvn clean package -Ppaquete  (genera target/dist/<app.name>, solo para el SO actual) -->
  <profiles>
    <profile>
      <id>paquete</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-maven-plugin</artifactId>
            <version>0.0.8</version>
            <executions>
              <execution>
                <id>make-jlink</id>
                <phase>package</phase>
                <goals>
                  <goal>jlink</goal>
                </goals>
                <configuration>
                  <mainClass>${app.module}/${app.mainClass}</mainClass>
                  <jlinkImageName>app-runtime</jlinkImageName>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>1.6.0</version>
            <executions>
              <execution>
                <id>jpackage</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
                <configuration>
                  <name>${app.name}</name>
                  <appVersion>${project.version}</appVersion>
                  <destination>target/dist</destination>
                  <type>APP_IMAGE</type>
                  <module>${app.module}/${app.mainClass}</module>
                  <runtimeImage>target/app-runtime</runtimeImage>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
